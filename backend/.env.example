# Application
NODE_ENV=development
PORT=5000
TRUST_PROXY=1
IP_HASH_SECRET=replace-with-a-long-random-server-secret
API_VERSION=v1
CLIENT_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=sqlite:./data/database.sqlite
# For PostgreSQL: postgresql://username:password@localhost:5432/findtheweb
# For MySQL: mysql://username:password@localhost:3306/findtheweb

# JWT Configuration
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# Admin Account Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-long-password
ADMIN_NAME=Administrator

# Server Configuration
FRONTEND_URL=http://localhost:3000

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=replace-with-a-long-random-session-secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=5

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=replace-with-smtp-password
FROM_EMAIL=support@findtheweb.site

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_ERROR_REPORTING=false
ENABLE_2FA=false

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,https://findtheweb.site

# Database Pool Configuration
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# Test Database (for running tests)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=findtheweb_test
TEST_DB_USER=test
TEST_DB_PASS=test

# Email (SendGrid)
#EMAIL_FROM=noreply@findtheweb.zus3cu.tech
#SENDGRID_API_KEY=your_sendgrid_api_key_here

# Google Analytics
GOOGLE_ANALYTICS_ID=G-KZKSFZSQW7

# Sentry (Error Tracking)
SENTRY_DSN=your_sentry_dsn_here

# Payment Gateways
#STRIPE_SECRET_KEY=your_stripe_secret_key
#STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
#PAYPAL_CLIENT_ID=your_paypal_client_id
#PAYPAL_SECRET=your_paypal_secret

# Frontend variables don't belong in backend .env file
# VITE_API_URL should be configured in frontend .env file only
