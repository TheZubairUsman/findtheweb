# API Configuration
# IMPORTANT: Do NOT include /api/v1 in VITE_API_URL as frontend components already add this prefix
# Including /api/v1 here will cause double-prefix URLs like /api/v1/api/v1/auth/admin/login
VITE_API_URL=http://localhost:5000

# Authentication is backend-only. Never expose JWT secrets or admin credentials
# through VITE_* variables because Vite bundles them into browser JavaScript.

# Environment
MODE=development

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false

# CORS Configuration (if needed)
VITE_CORS_ORIGIN=http://localhost:3000

# Database (for backend)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=findtheweb
DB_USER=postgres
DB_PASSWORD=replace-with-local-db-password

# Session (for backend)
SESSION_SECRET=replace-with-a-long-random-session-secret

# Email Configuration (if needed)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_FROM=noreply@findtheweb.zus3cu.tech
